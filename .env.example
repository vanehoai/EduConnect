# Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# PostgreSQL
POSTGRES_USER=school
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=school_management
POSTGRES_PORT=5433

DATABASE_URL=postgresql://school:change_this_password@localhost:5433/school_management?schema=public
TEST_DATABASE_URL=postgresql://school:change_this_password@localhost:5433/school_management_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=5

# Mock integrations
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-mock-payment-secret
MAIL_FROM=no-reply@school.local