# Application
NODE_ENV=production
PORT=3000
APP_URL=https://educonnect.example.com
API_URL=https://api.educonnect.example.com/api
CORS_ORIGIN=https://educonnect.example.com
NEXT_PUBLIC_API_URL=https://api.educonnect.example.com/api

# PostgreSQL
POSTGRES_USER=educonnect_prod_user
POSTGRES_PASSWORD=REQUIRE_STRONG_PRODUCTION_PASSWORD_HERE
POSTGRES_DB=educonnect_production
DATABASE_URL=postgresql://educonnect_prod_user:REQUIRE_STRONG_PRODUCTION_PASSWORD_HERE@postgres:5432/educonnect_production?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Authentication Secrets (Must be at least 32 random characters)
JWT_ACCESS_SECRET=REQUIRE_SECURE_RANDOM_32_CHAR_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=REQUIRE_SECURE_RANDOM_32_CHAR_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true

# Security & Rate Limiting
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=5

# Integrations
MOCK_PAYMENT_WEBHOOK_SECRET=REQUIRE_SECURE_WEBHOOK_SECRET_HERE
MAIL_FROM=no-reply@educonnect.example.com
