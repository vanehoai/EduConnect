# PostgreSQL Staging Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_secure_password
POSTGRES_DB=educonnect_staging
DATABASE_URL=postgresql://postgres:staging_secure_password@postgres:5432/educonnect_staging?schema=public

# Redis Staging Configuration
REDIS_URL=redis://redis:6379

# API Config
PORT=3000
NODE_ENV=staging
JWT_SECRET=super_secret_staging_jwt_key_live_2026
JWT_ACCESS_SECRET=access_secret_staging_1234567890_32chars
JWT_REFRESH_SECRET=refresh_secret_staging_1234567890_32char
MOCK_PAYMENT_WEBHOOK_SECRET=webhook_secret_staging_1234567890_32char
LOGIN_RATE_LIMIT_MAX=1000

# Web Config
NEXT_PUBLIC_API_URL=http://localhost:4000/api